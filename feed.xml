---
layout: none
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title type="text" xml:lang="en">{{ site.title | xml_escape }}</title>
  <link type="application/atom+xml" href="atom_feed_url" rel="self"/>
  <link type="text/html" href="home_url_canonical" rel="alternate"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ site.url }}{{ site.baseurl }}/</id>
  <author>
    <name>author_name</name>
  </author>
  <language>en-GB</language>
  <rights>{{ site.date.year }} Dominic Barnes</rights>
  <pubDate>{{ site.time | date_to_rfc822 }}</pubDate>
  <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
  <generator>Jekyll v{{ jekyll.version }}</generator>
  {% for post in site.posts %}
    <entry>
      <title>{{ post.title | xml_escape }}</title>
      <content type="html"><![CDATA[
        {{ post.content }}
      ]]></content>
      <updated>{{ post.date | date_to_rfc822 }}</updated>
      <id>{{ post.url | prepend: site.baseurl | prepend: site.url }}</id>
      {% for tag in post.tags %}
      <category>{{ tag | xml_escape }}</category>
      {% endfor %}
      {% for cat in post.categories %}
        <category>{{ cat | xml_escape }}</category>
      {% endfor %}
      {% if post.post_image %}
        <media:content xmlns:media="http://search.yahoo.com/mrss/" url="{{ post.post_image | prepend: site.baseurl | prepend: site.url }}" width="1000" height="1000" medium="image">
            <media:keywords>headline</media:keywords>
            <media:media_html>
                <![CDATA[]]>
            </media:media_html>
            <dc:identifier xmlns:dc="http://purl.org/dc/elements/1.1/">
                <![CDATA[1]]>
            </dc:identifier>
            <media:credit>
                <![CDATA[]]>
            </media:credit>
            <media:description>
                <![CDATA[]]>
            </media:description>
            <media:title>
                <![CDATA[]]>
            </media:title>
          </media:content>
      {% endif %}
    </entry>
  {% endfor %}
</feed>
